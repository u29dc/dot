# Shared workstation baseline for every machine. Personal-only apps live in
# Brewfile.personal; machine-only additions belong in ignored Brewfile.local.
# Layers are additive and listed in DOT_BREWFILES.

# 00 Terminal and shell
brew "fish"
brew "starship"
brew "zoxide"
brew "atuin"
brew "tmux"
brew "broot"

cask "ghostty@tip"
cask "font-fira-code"
cask "font-jetbrains-mono-nerd-font"
cask "font-new-computer-modern"
cask "font-sf-mono"

# 10 Git and source control
brew "git"
brew "gh"
brew "git-delta"
brew "gitui"
brew "lazygit"
brew "git-open"
brew "gitingest"

# 20 Editors and browsers
brew "neovim"

cask "cursor"
cask "google-chrome"
cask "zed@preview"
cask "thebrowsercompany-dia"

# 30 Languages and build tools
brew "oven-sh/bun/bun", trusted: true
brew "node"
brew "vite-plus"
brew "deno"
brew "zig"
brew "go"
brew "cmake"
brew "typst"
brew "uv"
brew "python"
brew "ruff"

# 40 CLI utilities and data tools
brew "eza"
brew "bat"
brew "fd"
brew "bottom"
brew "ripgrep"
brew "hyperfine"
brew "fastfetch"
brew "parallel"
brew "scc"
brew "tokei"
brew "wget"
brew "sd"
brew "dust"
brew "procs"
brew "jq"
brew "jaq"
brew "jsongrep"
brew "yq"
brew "just"
brew "direnv"
brew "tlrc"
brew "shellcheck"
brew "shfmt"

# 50 Documents, media, and assets
brew "ffmpeg"
brew "imagemagick"
brew "graphicsmagick"
brew "exiftool"
brew "libraw"
brew "dcraw"
brew "gifsicle"
brew "gifski"
brew "optipng"
brew "sox"
brew "webp"
brew "openexr"
brew "sevenzip"
brew "yt-dlp"
brew "poppler"
brew "yfedoseev/tap/pdf-oxide", trusted: true
brew "ghostscript"
brew "qpdf"

cask "markdown-preview"
cask "iina"
cask "keka"
cask "blender"

# 60 AI and agent tools
brew "anomalyco/tap/opencode", trusted: true
brew "agent-browser"
brew "getagentseal/codeburn/codeburn", trusted: true
brew "higgsfield-ai/tap/higgsfield", trusted: true
brew "openclaw/tap/gogcli", trusted: true
brew "whisperkit-cli"
brew "vercel"

cask "codex"
cask "chatgpt"
cask "claude"
cask "claude-code"
cask "codexbar"
cask "granola"
cask "opencode-desktop"

# 70 Work and productivity
brew "gnupg"

cask "1password-cli"
# Keep the package channel aligned with this machine's existing app data.
onepassword_casks = { "stable" => "1password", "beta" => "1password@beta", "nightly" => "1password@nightly" }
cask onepassword_casks.fetch(ENV.fetch("HOMEBREW_BUNDLE_ONEPASSWORD_CHANNEL", "stable"))
cask "slack"
cask "zoom"
cask "notion"
cask "notion-calendar"
cask "linear"
cask "obsidian"
cask "ticktick"
cask "figma"
cask "adobe-creative-cloud"
cask "cleanshot"
cask "pixelsnap"
cask "clop"
cask "coteditor"

# 80 System, input, and hardware
brew "blueutil"

cask "karabiner-elements"
cask "moves"
cask "logi-options+"
cask "monitorcontrol"
cask "display-pilot"
cask "vivid-app"
cask "cleanmymac"

# 90 Sync, backup, network, and personal
brew "vnstat"

cask "jordanbaird-ice"
cask "rana-gmbh/netfluss/netfluss", trusted: true
cask "blip"
cask "spotify"
cask "whatsapp"
cask "google-drive"
cask "adguard"

# Unmanaged applications
# App Store: Dato, Dropover, Folder Preview, Keystroke Pro, NextDNS, NotchPrompter, Spaced
# Vendor or manual install: DaVinci Resolve, Paper, Umbra, Writer
# Prerelease channel: Raycast Beta
