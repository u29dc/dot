#!/usr/bin/env bash
set -Eeuo pipefail

wrapper_path="$(/bin/realpath "${BASH_SOURCE[0]}")"
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$wrapper_path")/../.." && pwd -P)}"
export DOTFILES_DIR
# shellcheck source=shell/zsh/functions/agent-browser.sh
source "$DOTFILES_DIR/shell/zsh/functions/agent-browser.sh"

agent-browser-dia-on "$@"
