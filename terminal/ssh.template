# dotfiles-managed: generated ssh-config
# dotfiles-source: terminal/ssh.template

# =============================================================================
# SSH Configuration - Optimized for Git Operations
# =============================================================================

Include ~/.ssh/config.local

# =============================================================================
# Global Settings (applies to all hosts)
# =============================================================================
Host *
__SSH_IDENTITY_AGENT__

  # Cryptography: keep OpenSSH defaults. Since OpenSSH 10 they prefer the
  # post-quantum hybrid mlkem768x25519-sha256 key exchange, which a pinned
  # KexAlgorithms list would silently disable; pinned host key lists also
  # break servers that only offer ECDSA keys.

  # Connection Stability
  # Send keepalive every 60 seconds to prevent timeout through firewalls
  ServerAliveInterval 60
  ServerAliveCountMax 3
  TCPKeepAlive yes

  # Connection Multiplexing (HUGE performance win for Git operations)
  # Reuses a single connection for multiple SSH sessions
  # Makes subsequent git commands instant (no handshake overhead)
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m

  # Security Settings
  # Ask before connecting to unknown hosts (prevents auto-accepting)
  StrictHostKeyChecking ask

  # Hash hostnames in known_hosts file (privacy)
  HashKnownHosts yes

  # Enable compression (helpful for large git transfers)
  Compression yes

# =============================================================================
# Git Hosting Services (convenience shortcuts)
# =============================================================================

# GitHub
Host github.com
  HostName github.com
  User git

# GitLab
Host gitlab.com
  HostName gitlab.com
  User git
