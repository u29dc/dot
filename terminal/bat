# ~/.config/bat/config - bat configuration file
# https://github.com/sharkdp/bat

# ------------------------------------------------------------------------------
# THEME CONFIGURATION
# ------------------------------------------------------------------------------

# Automatic theme switching based on system appearance (macOS)
# This will detect if you're using dark or light mode and switch accordingly
--theme=auto:system

# Dark theme - used when macOS is in dark mode
--theme-dark=TwoDark

# Light theme - used when macOS is in light mode
--theme-light=GitHub

# ------------------------------------------------------------------------------
# DISPLAY OPTIONS
# ------------------------------------------------------------------------------

# Disable automatic paging (no 'less' pager)
# Output is displayed directly to terminal
--paging=never

# Style components to display (the BAT_STYLE env var would override this)
# - numbers: show line numbers
# - changes: show git modification markers (+/-/~)
--style=numbers,changes

# Display options
--wrap=never
--tabs=4

# ------------------------------------------------------------------------------
# SYNTAX MAPPINGS
# ------------------------------------------------------------------------------

# Only files bat does not already detect. Built-in mappings cover .gitignore,
# Dockerfile.*, *.conf, *.cfg, Brewfile, justfile, *.toml, **/.ssh/config and
# .env files (DotENV), so they are not repeated here.

# Shell configuration files without a leading dot, as stored in this repo
--map-syntax="zshrc:Bourne Again Shell (bash)"
--map-syntax="bashrc:Bourne Again Shell (bash)"
--map-syntax="zprofile:Bourne Again Shell (bash)"
--map-syntax="bash_profile:Bourne Again Shell (bash)"

# Logs and JSON-flavoured configuration files
--map-syntax="*.log:Log File"
--map-syntax=".prettierrc:JSON"
--map-syntax=".eslintrc:JSON"
--map-syntax="*.jsonc:JSON"
