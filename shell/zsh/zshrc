# ~/.zshrc - Main Zsh configuration file

# ------------------------------------------------------------------------------
# ENVIRONMENT & PATH
# Setting up environment variables and command search path
# ------------------------------------------------------------------------------

# Add user directories to PATH for custom scripts and tools.
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
path=("$HOME/.bun/bin" "$HOME/bin" "/opt/homebrew/bin" "/opt/homebrew/sbin" "$HOME/.local/bin" "$CARGO_HOME/bin" "${path[@]}")
typeset -U path
export PATH

# Dotfiles checkout and machine-local setup facts. Resolve the checkout from
# this symlinked config so the repository can live anywhere.
_dot_zshrc_path="${${(%):-%N}:A}"
export DOTFILES_DIR="${DOTFILES_DIR:-${_dot_zshrc_path:h:h:h}}"
unset _dot_zshrc_path
export DOT_ENV_FILE="${DOT_ENV_FILE:-$DOTFILES_DIR/setup.env}"
DOT_ZSH_ENV_FILE="${DOT_ZSH_ENV_FILE:-$HOME/.config/dot/env.zsh}"
if [ -f "$DOT_ZSH_ENV_FILE" ]; then
    source "$DOT_ZSH_ENV_FILE"
elif [ -f "$DOT_ENV_FILE" ]; then
    set -a
    source "$DOT_ENV_FILE"
    set +a
fi

# Obsidian CLI
export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"

# Fallbacks for a shell started before setup rendered env.zsh; rendered values win.
export TOOLS_HOME="${TOOLS_HOME:-$HOME/.tools}"
export CHO_HOME="${CHO_HOME:-$TOOLS_HOME/cho}"
export FIN_HOME="${FIN_HOME:-$TOOLS_HOME/fin}"
export LET_HOME="${LET_HOME:-$TOOLS_HOME/let}"
export TAO_HOME="${TAO_HOME:-$TOOLS_HOME/tao}"
export CHO="${CHO:-$CHO_HOME/cho}"
export FIN="${FIN:-$FIN_HOME/fin}"
export LET="${LET:-$LET_HOME/let}"
export TAO="${TAO:-$TAO_HOME/tao}"
export SKILLS_BASE="${SKILLS_BASE:-$DOTFILES_DIR/agents/skills}"
export HOMEBREW_NO_ENV_HINTS="${HOMEBREW_NO_ENV_HINTS:-1}"
export BAT_PAGER="${BAT_PAGER-}"
EZA_DEFAULT_IGNORE="${EZA_DEFAULT_IGNORE:-node_modules|.cache|cache|dist|build|.next|.nuxt|.turbo|coverage|.pytest_cache|__pycache__|.venv|venv|.env}"

# Starship theme switching based on macOS appearance
starship_theme() {
    if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == "Dark" ]]; then
        export STARSHIP_CONFIG="$HOME/.config/starship/starship-dark.toml"
    else
        export STARSHIP_CONFIG="$HOME/.config/starship/starship-light.toml"
    fi
}
starship_theme

# ------------------------------------------------------------------------------
# ZSH COMPLETION SYSTEM
# Enable and configure advanced tab completion
# ------------------------------------------------------------------------------

# Enable completion system
autoload -Uz compinit
# Only regenerate compdump once per day for performance
if [[ ! -f "$HOME/.zcompdump" || "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' "$HOME/.zcompdump" 2>/dev/null)" ]]; then
    compinit
else
    compinit -C
fi

# Enhanced completion options
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ------------------------------------------------------------------------------
# ZSH HISTORY CONFIGURATION
# Optimize shell history behavior
# ------------------------------------------------------------------------------

# History configuration (before atuin)
export HISTSIZE=50000
export SAVEHIST=50000
export HISTFILE="$HOME/.zsh_history"

# History options
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_VERIFY
setopt SHARE_HISTORY

# Navigation enhancements
setopt AUTO_CD              # cd by typing directory name
setopt AUTO_PUSHD           # Push directories to stack
setopt PUSHD_IGNORE_DUPS    # No duplicates in dir stack

# Globbing improvements
setopt EXTENDED_GLOB        # Extended pattern matching
setopt GLOB_DOTS            # Include dotfiles in globs

# ------------------------------------------------------------------------------
# ALIASES
# Command shortcuts and modern CLI tool replacements
# ------------------------------------------------------------------------------

# System & Shell Aliases
alias cls='clear && echo "" > ~/.zsh_history && fc -p /dev/null && starship_theme && exec zsh'

# File and directory tools
alias cat='bat --paging=never'
alias find='fd'
alias ls="eza --icons -I $'Icon\r'"
alias ll='eza --icons -la'
alias lt='eza --icons --tree'
alias tree='eza --icons -T'
alias treed='eza --icons -T --only-dirs'

# Runtime and utility shortcuts
alias b='bun run'
alias context='bunx contextcalc@latest --bars --depth 3 --min-tokens 1000 --sort name --output tree'
alias htop='btm'
alias top='btm'
alias scc='scc --no-cocomo'

# Python compatibility shims
alias python='uv run python'
alias python3='uv run python3'
alias virtualenv='uv venv'

# ------------------------------------------------------------------------------
# FUNCTIONS
# Custom shell functions for enhanced functionality
# ------------------------------------------------------------------------------

cho() { "$CHO" "$@"; }
fin() { "$FIN" "$@"; }
tao() { "$TAO" "$@"; }
# let is an alias at the end of this file: a let() function would replace the
# let builtin that zsh completion (_arguments) relies on.

# Navigation and app shortcuts. Paths are optional and come from setup.env.
_dot_cd_required() {
    local label="$1"
    local path="$2"

    if [[ -z "$path" ]]; then
        printf '%s is not configured in setup.env\n' "$label" >&2
        return 1
    fi

    cd "$path" || return $?
}

gdrive() { _dot_cd_required DOT_GDRIVE_HOME "$DOT_GDRIVE_HOME"; }
dropbox() { _dot_cd_required DOT_DROPBOX_HOME "$DOT_DROPBOX_HOME"; }
dd() { dropbox "$@"; }
oo() { _dot_cd_required DOT_VAULT_HOME "$DOT_VAULT_HOME"; }
vault() { oo "$@"; }

obsidian() {
    if (( $# > 0 )); then
        command open -a Obsidian "$@"
    elif [[ -n "$DOT_VAULT_HOME" ]]; then
        command open -a Obsidian "$DOT_VAULT_HOME"
    else
        command open -a Obsidian
    fi
}

# Repo maintenance helpers
_local_biome_info() {
    (
        cd "$1" || exit 1
        bun --no-install --eval '
            import path from "node:path";
            import { createRequire } from "node:module";

            const require = createRequire(process.cwd() + "/noop.js");

            try {
                const pkgPath = require.resolve("@biomejs/biome/package.json");
                const pkg = require(pkgPath);
                const binRel = typeof pkg.bin === "string" ? pkg.bin : pkg.bin?.biome;

                if (!pkg.version || !binRel) {
                    process.exit(1);
                }

                console.log(`${pkg.version}\t${path.resolve(path.dirname(pkgPath), binRel)}`);
            } catch {
                process.exit(1);
            }
        '
    )
}

bup() {
    local repo_root=""
    local biome_info=""
    local biome_before=""
    local biome_after=""
    local biome_bin=""

    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || repo_root=""
    fi

    if [[ -z "$repo_root" ]]; then
        repo_root="$PWD"
    fi

    if [[ -f "$repo_root/biome.json" || -f "$repo_root/biome.jsonc" ]]; then
        biome_info="$(_local_biome_info "$repo_root" 2>/dev/null)" || biome_info=""

        if [[ -n "$biome_info" ]]; then
            IFS=$'\t' read -r biome_before biome_bin <<< "$biome_info"
        fi
    fi

    bun update --latest || return $?

    if [[ -n "$biome_before" ]]; then
        biome_info="$(_local_biome_info "$repo_root" 2>/dev/null)" || biome_info=""

        if [[ -n "$biome_info" ]]; then
            IFS=$'\t' read -r biome_after biome_bin <<< "$biome_info"
        fi
    fi

    if [[ -n "$biome_before" && -n "$biome_after" && "$biome_before" != "$biome_after" && -x "$biome_bin" ]]; then
        (
            cd "$repo_root" || exit 1
            "$biome_bin" migrate --write
        )
    fi
}

# CLI wrappers
eza() {
    if [[ "$*" == *"--tree"* ]] || [[ "$*" == *"-T"* ]]; then
        command eza --icons --git-ignore -I "$EZA_DEFAULT_IGNORE" "$@"
    else
        command eza --icons "$@"
    fi
}

zed() {
    if ! command -v zed-preview >/dev/null 2>&1; then
        printf 'zed-preview not found; install the zed@preview cask\n' >&2
        return 127
    fi

    if [ $# -eq 0 ]; then
        command zed-preview .
    else
        command zed-preview "$@"
    fi
}

# Package manager shims
pip() { uv pip "$@"; }
pip3() { uv pip "$@"; }

# ------------------------------------------------------------------------------
# EXTERNAL FUNCTIONS
# Load repo-managed shell helpers
# ------------------------------------------------------------------------------

if [[ -f "$DOTFILES_DIR/shell/zsh/functions/update.sh" ]]; then
    source "$DOTFILES_DIR/shell/zsh/functions/update.sh"
fi

if [[ -f "$DOTFILES_DIR/shell/zsh/functions/agent-browser.sh" ]]; then
    source "$DOTFILES_DIR/shell/zsh/functions/agent-browser.sh"
fi

# ------------------------------------------------------------------------------
# SHELL INTEGRATIONS
# Initialize command-line tools and enhancements
# ------------------------------------------------------------------------------

_dot_source_cached_init() {
    local cache_name="$1"
    local command_name="$2"
    local bin_path cache_dir cache_file temp_file
    shift 2

    bin_path="$(command -v "$command_name" 2>/dev/null)" || return 0
    [[ -n "$bin_path" ]] || return 0

    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dot/shell"
    cache_file="$cache_dir/$cache_name.zsh"
    mkdir -p "$cache_dir" || return 0

    if [[ ! -s "$cache_file" || "$bin_path" -nt "$cache_file" ]]; then
        temp_file="$cache_file.$$.$RANDOM.tmp"
        if "$command_name" "$@" >"$temp_file" 2>/dev/null; then
            mv -f "$temp_file" "$cache_file"
        else
            rm -f "$temp_file"
        fi
    fi

    [[ -s "$cache_file" ]] && source "$cache_file"
}

# Initialize zoxide (smart cd replacement)
_dot_source_cached_init zoxide-init zoxide init zsh

# Initialize Atuin (magical shell history)
_dot_source_cached_init atuin-init atuin init zsh

# Initialize Starship prompt in real interactive terminals.
if [[ "$TERM" != "dumb" ]]; then
    _dot_source_cached_init starship-init starship init zsh
fi

# Initialize uv completions
_dot_source_cached_init uv-completion uv generate-shell-completion zsh

# Initialize direnv (per-directory .envrc environments)
_dot_source_cached_init direnv-hook direnv hook zsh

# Bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# Broot launcher integration
if [ -f "$HOME/.config/broot/launcher/bash/br" ]; then
    source "$HOME/.config/broot/launcher/bash/br"
fi

# Google Cloud SDK integration
GCLOUD_SDK_HOME="${GCLOUD_SDK_HOME:-$HOME/google-cloud-sdk}"
[ -f "$GCLOUD_SDK_HOME/path.zsh.inc" ] && source "$GCLOUD_SDK_HOME/path.zsh.inc"
[ -f "$GCLOUD_SDK_HOME/completion.zsh.inc" ] && source "$GCLOUD_SDK_HOME/completion.zsh.inc"

# CF CLI completions
[[ -f "$HOME/.config/cf/completions/_cf.zsh" ]] && source "$HOME/.config/cf/completions/_cf.zsh"

# ------------------------------------------------------------------------------
# LOCAL OVERRIDES
# Machine-specific settings like API keys, aliases, PATH modifications
# Configure your secrets and machine-specific settings in ~/.zshrc.local.
# See shell/zsh/zshrc.local.example for a template.
# ------------------------------------------------------------------------------

if [ -f "$HOME/.zshrc.local" ]; then
    source "$HOME/.zshrc.local"
fi

# Defined last so no later-parsed function body captures it. `command let`
# runs the external tool; autoloaded code still gets the let builtin.
alias let='command let'
